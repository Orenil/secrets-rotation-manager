# Copy to .env and adjust as needed. Defaults match `npm run db:setup`.

PORT=3000

# Admin/superuser connection used for control-plane tables AND for
# CREATE ROLE / GRANT / REVOKE / DROP ROLE / pg_stat_activity telemetry.
# In production this would be a narrowly-scoped Vault-issued admin lease,
# not a long-lived superuser connection string.
DATABASE_URL=postgresql://postgres@127.0.0.1:5544/rotation_manager

# Connection info handed to dependents alongside each rotated credential.
APP_DB_HOST=127.0.0.1
APP_DB_PORT=5544
APP_DB_NAME=rotation_manager

# 64 hex chars (32 bytes) for AES-256-GCM. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# How long a newly-rotated credential and the old one stay valid together
# before an un-switched-over dependent triggers an alert instead of a
# blind revoke.
ROTATION_GRACE_PERIOD_MS=8000

# How often the telemetry loop checks pg_stat_activity for lingering use
# of the old credential.
TELEMETRY_POLL_INTERVAL_MS=750
